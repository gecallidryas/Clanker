# ============================================
# Guild Config - Example .env
# ============================================
# This file is uploaded by server admins via /config env upload.
# Only include keys and models below.

# ============================================
# Gemini API Keys (General chat)
# ============================================
# https://aistudio.google.com/app/apikey
# Set GEMINI_KEY_TYPE=free to always rotate keys each request.
# Use GEMINI_KEY_TYPE=paid to stick to a key unless it fails.
GEMINI_KEY_TYPE=paid
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Recommended Gemini model names:
#   gemini-2.5-flash-lite
#   gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# ============================================
# Gemini API Key (Profile analysis)
# ============================================
# Used by /analyze (personality summary).
GEMINI_PROFILE_KEY=

# ============================================
# Gemini API Keys (Translation)
# ============================================
GEMINI_TRANSLATE_KEY=
GEMINI_TRANSLATE_KEY_2=
GEMINI_TRANSLATE_KEY_3=
GEMINI_TRANSLATE_KEY_4=
GEMINI_TRANSLATE_KEY_5=

# ============================================
# Gemini API Keys (Summarization)
# ============================================
GEMINI_SUMMARIZE_KEY=
GEMINI_SUMMARIZE_KEY_2=
GEMINI_SUMMARIZE_KEY_3=
GEMINI_SUMMARIZE_KEY_4=
GEMINI_SUMMARIZE_KEY_5=

# ============================================
# OpenRouter (Uncensored)
# ============================================
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OpenRouter model aliases (recommended):
#   venice, hermes, deephermes, mistral, deepseek
# Full model IDs also work (examples):
#   cognitivecomputations/dolphin-mistral-24b-venice-edition:free
#   nousresearch/hermes-3-llama-3.1-405b:free
#   nousresearch/deephermes-3-mistral-24b-preview
#   mistralai/mistral-small-3.1-24b-instruct:free
#   deepseek/deepseek-chat
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Optional comma-separated fallbacks (aliases or full IDs):
OPENROUTER_FALLBACK_MODELS=

# ============================================
# Web Search (Optional)
# ============================================
# Brave Search API key (optional)
# sign up for brave api (free for 2000 queries per month):https://api-dashboard.search.brave.com/register?
BRAVE_API_KEY=

# ============================================
# GIF Replies (Optional)
# ============================================

# ============================================
# Image Generation (Optional)
# ============================================
# Choose provider: replicate or openrouter
IMAGE_PROVIDER=
# Provider-specific model (Replicate version ID or OpenRouter image model)
IMAGE_MODEL=
# Replicate API key (required if provider=replicate)
REPLICATE_API_KEY=

# ============================================
# Custom Endpoint (Optional)
# ============================================
# OpenAI-compatible endpoint settings
CUSTOM_ENDPOINT_URL=
CUSTOM_ENDPOINT_API_KEY=
CUSTOM_MODEL_NAME=
CUSTOM_MODEL_CAPABILITIES=tools,vision
CUSTOM_ENDPOINT_ENABLED=false
