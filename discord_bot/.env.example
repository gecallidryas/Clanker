# ============================================
# Femmy Discord Bot - Example Environment File
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Discord Bot Token (from Discord Developer Portal)
# https://discord.com/developers/applications
DISCORD_TOKEN=

# ============================================
# Encryption (Required)
# ============================================
# Used to encrypt guild API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ============================================
# Optional Configuration
# ============================================

# ============================================
# Database Configuration (Per-Guild DBs)
# ============================================
# Directory that stores per-guild SQLite DBs (default: discord_bot/data)
DATABASE_DIR=data

# Global database for bot stats + guild registry (default: data/global.db)
GLOBAL_DATABASE_PATH=

# Legacy single-db path used by the migration script (optional)
LEGACY_DATABASE_PATH=

# ============================================
# Personality Mode Lock (Optional)
# ============================================
# Set to lock the bot to a single personality mode
# This disables the !mode command and fixes the personality
# Options: femboy, tsundere, oneesan
# Leave empty to allow per-server mode switching
BOT_MODE=

# Command prefix (default: !)
# Set to a different prefix like "!?" for Yumi to avoid conflicts
COMMAND_PREFIX=!

# ============================================
# Uncensored AI (Evil Mode)

# OpenRouter Model ID (Optional, default: venice)
# Options:
#   venice     (cognitivecomputations/dolphin-mistral-24b-venice-edition:free)
#   hermes     (nousresearch/hermes-3-llama-3.1-405b:free)
#   deephermes (nousresearch/deephermes-3-mistral-24b-preview)
#   mistral    (mistralai/mistral-small-3.1-24b-instruct:free)
#   deepseek   (deepseek/deepseek-chat)
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Optional OpenRouter tuning
# Comma-separated fallback models (keys or full model IDs)
# OPENROUTER_FALLBACK_MODELS=venice,deepseek
OPENROUTER_REQUEST_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=4
OPENROUTER_RETRY_BASE_SECONDS=0.6
OPENROUTER_RETRY_MAX_SECONDS=6
OPENROUTER_MODEL_COOLDOWN_SECONDS=30
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.8

# Optional OpenRouter app headers (recommended by OpenRouter)
OPENROUTER_APP_URL=https://github.com/gecallidryas/femboi
OPENROUTER_APP_TITLE=Femmy Discord Bot

# ============================================
# Admin Controls (Deprecated)
# ============================================
# Legacy global admin password (deprecated; use /config password instead)
ADMIN_PASSWORD=

# ============================================
