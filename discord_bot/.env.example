# ============================================
# Femmy Discord Bot - Example Environment File
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# Canonical env names matter here. Common aliases like BOT_TOKEN and
# GOOGLE_API_KEY are not read by this codebase unless you add your own shim.
# Preferred provider-key workflow:
#   use /config env upload with guild env values instead of putting AI/API keys
#   in this global .env file.

# Discord Bot Token (from Discord Developer Portal)
# https://discord.com/developers/applications
# Required at startup.
# Note: BOT_TOKEN is a common old name, but this repo reads DISCORD_TOKEN.
DISCORD_TOKEN=

# ============================================
# Encryption (Required)
# ============================================
# Used to encrypt guild API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ============================================
# Optional Configuration
# ============================================

# ============================================
# Database Configuration (Per-Guild DBs)
# ============================================
# Directory that stores per-guild SQLite DBs (default: discord_bot/data)
DATABASE_DIR=data

# Global database for bot stats + guild registry (default: data/global.db)
GLOBAL_DATABASE_PATH=

# Legacy single-db path used by the migration script (optional)
LEGACY_DATABASE_PATH=

# ============================================
# Optional Global AI Fallbacks (Dev / Local Only)
# ============================================
# Preferred production path:
#   upload guild-scoped keys with /config env upload.
# Only set these global Gemini keys if you intentionally want a local fallback
# when a guild-specific key is absent.
# The runtime reads GEMINI_API_KEY and optional numbered fallbacks.
# Note: GOOGLE_API_KEY is a common old name, but this repo reads GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Optional Gemini model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=45

# ============================================
# Personality Mode Lock (Optional)
# ============================================
# Set to lock the bot to a single personality mode
# This disables the !mode command and fixes the personality
# Options: default, clanker, femboy, tsundere, oneesan
# Leave empty to allow per-server mode switching
BOT_MODE=

# Command prefix (default: !)
# Set to a different prefix like "!?" for Yumi to avoid conflicts
COMMAND_PREFIX=!

# ============================================
# Uncensored AI (Evil Mode)

# OpenRouter Model ID (Optional, default: venice)
# Options:
#   venice     (cognitivecomputations/dolphin-mistral-24b-venice-edition:free)
#   hermes     (nousresearch/hermes-3-llama-3.1-405b:free)
#   deephermes (nousresearch/deephermes-3-mistral-24b-preview)
#   mistral    (mistralai/mistral-small-3.1-24b-instruct:free)
#   deepseek   (deepseek/deepseek-chat)
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Optional OpenRouter tuning
# Comma-separated fallback models (keys or full model IDs)
# OPENROUTER_FALLBACK_MODELS=venice,deepseek
OPENROUTER_REQUEST_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=4
OPENROUTER_RETRY_BASE_SECONDS=0.6
OPENROUTER_RETRY_MAX_SECONDS=6
OPENROUTER_MODEL_COOLDOWN_SECONDS=30
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.8

# Optional OpenRouter app headers (recommended by OpenRouter)
OPENROUTER_APP_URL=https://github.com/gecallidryas/femboi
OPENROUTER_APP_TITLE=Femmy Discord Bot

# ============================================
# Web Search (Optional)
# ============================================
# Preferred path: upload per-guild values with /config env upload.
# Set here only if you want a global fallback for local/dev use.
BRAVE_API_KEY=

# ============================================
# GIF Replies (Optional)
# ============================================
# Preferred path: upload per-guild values with /config env upload.
# Set here only if you want a global fallback for local/dev use.
TENOR_API_KEY=
# Optional client key (defaults to femboibot)
TENOR_CLIENT_KEY=

# ============================================
# Image Generation (Optional)
# ============================================
# Preferred path: upload per-guild values with /config env upload.
# Set here only if you want a global fallback for local/dev use.
REPLICATE_API_KEY=

# ============================================
# Activity Randomizer (Optional)
# ============================================
# Enable global activity randomizer (presence is global; per-guild activity is not supported)
ACTIVITY_RANDOMIZER_ENABLED=true
# How often to rotate activities (seconds). 3600 = 1 hour.
ACTIVITY_RANDOMIZER_INTERVAL_SECONDS=3600
# Dedicated Gemini key for the activity rotator.
# If left empty, activity generation may fail even when GEMINI_API_KEY is set.
GEMINI_ACTIVITY_KEY=
# Optional model override
GEMINI_ACTIVITY_MODEL=gemini-2.5-flash-lite

# ============================================
# RAG / Postgres (Optional)
# ============================================
# Enable local RAG retrieval (requires Postgres + pgvector)
ACTIVATE_LOCAL_RAG=false
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=1536
RAG_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional embedding API key fallback. Prefer guild env upload when applicable.
RAG_EMBEDDING_API_KEY=
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# ============================================
# Custom Endpoint (Optional)
# ============================================
# Timeout for custom OpenAI-compatible endpoint
CUSTOM_ENDPOINT_TIMEOUT_SECONDS=45

# ============================================
# Dev Flags
# ============================================
GIF_ANALYSIS_ENABLED=false

# ============================================
# Admin Controls (Deprecated)
# ============================================
# Legacy global admin password (deprecated; use /config password instead)
ADMIN_PASSWORD=

# ============================================
