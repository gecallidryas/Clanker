# ============================================
# Femmy Discord Bot - Example Environment File
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Discord Bot Token (from Discord Developer Portal)
# https://discord.com/developers/applications
DISCORD_TOKEN=

# ============================================
# Gemini API Keys (Automatic Failover)
# ============================================
# Primary key (required)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Backup keys (optional) - automatically used if primary fails/rate limited
# Create multiple keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Add up to GEMINI_API_KEY_10 for more capacity

# ============================================
# Optional Configuration
# ============================================

# Portfolio URL for status checks
PORTFOLIO_URL=

# Default bump channel ID (used if no per-server bump channel is set)
BUMP_CHANNEL_ID=

# ============================================
# Personality Mode Lock (Optional)
# ============================================
# Set to lock the bot to a single personality mode
# This disables the !mode command and fixes the personality
# Options: femboy, tsundere, oneesan
# Leave empty to allow per-server mode switching
BOT_MODE=

# ============================================
# Uncensored AI (Evil Mode)
# ============================================
# OpenRouter API Key for uncensored models (Venice/Hermes)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model ID (Optional, default: venice)
# Options: 
#   venice  (cognitivecomputations/dolphin-mistral-24b-venice-edition:free)
#   hermes  (nousresearch/hermes-3-llama-3.1-405b:free)
OPENROUTER_MODEL=venice
