[Unit]
Description=Femmy Discord Bot
Documentation=https://github.com/gecallidryas/femboi
After=network.target

[Service]
Type=simple
User=femmy
Group=femmy
WorkingDirectory=/opt/femmy-bot/discord_bot

# Python executable and main script
ExecStart=/opt/femmy-bot/venv/bin/python main.py

# Restart policy
Restart=always
RestartSec=10

# Environment
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/femmy-bot/discord_bot/.env

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/femmy-bot/discord_bot/logs /opt/femmy-bot/discord_bot

# Resource limits (adjust as needed)
MemoryMax=512M
CPUQuota=50%

# Logging (goes to journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=femmy-bot

[Install]
WantedBy=multi-user.target
